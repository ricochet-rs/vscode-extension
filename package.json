{
  "name": "ricochet",
  "displayName": "Ricochet",
  "description": "Deploy and manage Ricochet content from VS Code and Positron.",
  "version": "0.1.0",
  "publisher": "ricochet-rs",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ricochet-rs/vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ricochet",
    "deploy",
    "r",
    "python",
    "quarto",
    "shiny",
    "positron"
  ],
  "activationEvents": [
    "workspaceContains:**/_ricochet.toml"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "media/**",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ricochet",
          "title": "Ricochet",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "ricochet": [
        {
          "id": "ricochet.project",
          "name": "Project",
          "icon": "media/activity-bar.svg"
        },
        {
          "id": "ricochet.bundle",
          "name": "Bundle",
          "icon": "media/activity-bar.svg"
        },
        {
          "id": "ricochet.deployments",
          "name": "Deployments",
          "icon": "media/activity-bar.svg"
        },
        {
          "id": "ricochet.servers",
          "name": "Servers",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ricochet.project",
        "contents": "No _ricochet.toml found in this workspace.\n\nA Ricochet project is a directory holding a _ricochet.toml beside its lockfile.\n[Create _ricochet.toml](command:ricochet.createConfig)\n[Read the documentation](https://docs.ricochet.rs)",
        "when": "!ricochet.hasProject"
      },
      {
        "view": "ricochet.servers",
        "contents": "No Ricochet servers are configured.\n[Add a server](command:ricochet.addServer)"
      }
    ],
    "commands": [
      {
        "command": "ricochet.deploy",
        "title": "Deploy",
        "category": "Ricochet",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ricochet.invokeTask",
        "title": "Run Task Now",
        "category": "Ricochet",
        "icon": "$(play)"
      },
      {
        "command": "ricochet.openInBrowser",
        "title": "Open Deployed Item in Browser",
        "category": "Ricochet",
        "icon": "$(link-external)"
      },
      {
        "command": "ricochet.openConfig",
        "title": "Open _ricochet.toml",
        "category": "Ricochet",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ricochet.changeContentType",
        "title": "Change Content Type",
        "category": "Ricochet",
        "icon": "$(edit)"
      },
      {
        "command": "ricochet.copyLockfileCommand",
        "title": "Copy Command to Create Lockfile",
        "category": "Ricochet",
        "icon": "$(copy)"
      },
      {
        "command": "ricochet.createConfig",
        "title": "Create _ricochet.toml",
        "category": "Ricochet"
      },
      {
        "command": "ricochet.selectProject",
        "title": "Select Active Project",
        "category": "Ricochet"
      },
      {
        "command": "ricochet.refresh",
        "title": "Refresh",
        "category": "Ricochet",
        "icon": "$(refresh)"
      },
      {
        "command": "ricochet.addServer",
        "title": "Add Server",
        "category": "Ricochet",
        "icon": "$(add)"
      },
      {
        "command": "ricochet.login",
        "title": "Login",
        "category": "Ricochet",
        "icon": "$(key)"
      },
      {
        "command": "ricochet.setDefaultServer",
        "title": "Set as Default",
        "category": "Ricochet"
      },
      {
        "command": "ricochet.logout",
        "title": "Sign Out",
        "category": "Ricochet"
      },
      {
        "command": "ricochet.forgetServer",
        "title": "Forget",
        "category": "Ricochet"
      },
      {
        "command": "ricochet.showLog",
        "title": "Show Log",
        "category": "Ricochet",
        "icon": "$(output)"
      },
      {
        "command": "ricochet.openDeployment",
        "title": "Open Deployment in Browser",
        "category": "Ricochet",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ricochet.setDefaultServer",
          "when": "false"
        },
        {
          "command": "ricochet.logout",
          "when": "false"
        },
        {
          "command": "ricochet.forgetServer",
          "when": "false"
        },
        {
          "command": "ricochet.openDeployment",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "ricochet.deploy",
          "when": "view == ricochet.project",
          "group": "navigation@1"
        },
        {
          "command": "ricochet.refresh",
          "when": "view == ricochet.project",
          "group": "navigation@2"
        },
        {
          "command": "ricochet.refresh",
          "when": "view == ricochet.bundle",
          "group": "navigation@1"
        },
        {
          "command": "ricochet.refresh",
          "when": "view == ricochet.deployments",
          "group": "navigation@1"
        },
        {
          "command": "ricochet.addServer",
          "when": "view == ricochet.servers",
          "group": "navigation@1"
        },
        {
          "command": "ricochet.refresh",
          "when": "view == ricochet.servers",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ricochet.changeContentType",
          "when": "view == ricochet.project && viewItem == ricochet.contentType",
          "group": "inline"
        },
        {
          "command": "ricochet.copyLockfileCommand",
          "when": "view == ricochet.project && viewItem == ricochet.missingLockfile",
          "group": "inline"
        },
        {
          "command": "ricochet.login",
          "when": "view == ricochet.servers && viewItem == ricochet.server",
          "group": "inline"
        },
        {
          "command": "ricochet.setDefaultServer",
          "when": "view == ricochet.servers && viewItem == ricochet.server",
          "group": "server@1"
        },
        {
          "command": "ricochet.login",
          "when": "view == ricochet.servers && viewItem == ricochet.server",
          "group": "server@2"
        },
        {
          "command": "ricochet.logout",
          "when": "view == ricochet.servers && viewItem == ricochet.server",
          "group": "server@3"
        },
        {
          "command": "ricochet.forgetServer",
          "when": "view == ricochet.servers && viewItem == ricochet.server",
          "group": "server@4"
        },
        {
          "command": "ricochet.openDeployment",
          "when": "view == ricochet.deployments && viewItem == ricochet.deployment",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "ricochet.deploy",
          "when": "resourceFilename == _ricochet.toml",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ricochet",
      "properties": {
        "ricochet.cli.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `ricochet` executable. Leave empty to search `PATH` and the default install locations.",
          "scope": "machine-overridable"
        },
        "ricochet.server": {
          "type": "string",
          "default": "",
          "markdownDescription": "Server profile name or URL to target, passed as `--server`. Leave empty to use the CLI's default server.",
          "scope": "resource"
        },
        "ricochet.deploy.confirm": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deploying."
        },
        "ricochet.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report _ricochet.toml problems as editor diagnostics."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run esbuild.mjs",
    "watch": "bun run esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:host": "bun run build && bun run test/host/runTest.ts",
    "package": "bun run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "toml-eslint-parser": "^1.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "mocha": "^11",
    "ovsx": "^1.3.0",
    "prettier": "^3.4.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
